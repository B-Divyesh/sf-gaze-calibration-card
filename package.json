{
  "name": "gaze-calibration-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build:app": "tsc --noEmit && vite build --config vite.app.config.ts",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.8.4",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
