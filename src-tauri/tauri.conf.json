{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaze Calibration Card",
  "version": "0.1.4",
  "identifier": "in.sociobot.gaze-calibration-card",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "Gaze Calibration Card",
      "label": "main",
      "width": 1280,
      "height": 820,
      "minWidth": 390,
      "minHeight": 640,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Compare a gaze-controlled pointer in about 30 seconds",
    "longDescription": "A nine-target comparison of pointer error, drift, and time held on target.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
